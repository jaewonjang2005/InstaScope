{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "env": {
    "UV_LINK_MODE": "copy"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60
    }
  }
}
